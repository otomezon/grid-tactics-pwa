{
  "name": "grid-tactics-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test --config playwright.dev.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@unplugin-pwa/vite": "0.0.7",
    "@vitejs/plugin-react": "6.3.0",
    "magicast": "0.5.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
